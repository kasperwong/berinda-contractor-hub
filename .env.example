# Firebase web configuration. These identify the Firebase project but are not administrator secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Add only after App Check is configured in the Firebase console.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Never place a Firebase Admin private key or Microsoft client secret in this file.
